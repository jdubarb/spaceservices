<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The remade VEE orbital ship crash retains the legacy SpaceBattle condition ID. -->
  <SpaceServices.SpaceServiceHazardRuleDef>
    <defName>JDB_SpaceServices_VEE_SpaceBattle_ShuttleHazard</defName>
    <label>VEE orbital ship crash shuttle hazard</label>
    <requiredPackageIds>
      <li>VanillaExpanded.VEE</li>
    </requiredPackageIds>
    <gameConditionDefNames>
      <li>SpaceBattle</li>
    </gameConditionDefNames>
    <serviceKinds>
      <li>hospital</li>
      <li>hospitality</li>
    </serviceKinds>
    <blockArrivals>true</blockArrivals>
    <delayDepartures>true</delayDepartures>
    <reason>orbital ship crash debris</reason>
  </SpaceServices.SpaceServiceHazardRuleDef>

  <!-- PsychicRain is an inert legacy condition in the remade VEE used by 1.7.
       It must not strand guests or suppress service traffic. -->

</Defs>
